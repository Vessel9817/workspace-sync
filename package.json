{
    "name": "workspace-sync",
    "version": "1.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "description": "Makes sure workspace lockfiles files are synced with the project root lockfile.",
    "bin": {
        "workspace-sync": "./dist/cli.ts"
    },
    "exports": {
        ".": "./dist/index.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vessel9817/workspace-sync.git"
    },
    "homepage": "https://github.com/Vessel9817/workspace-sync#readme",
    "readme": "https://github.com/Vessel9817/workspace-sync/blob/main/README.md",
    "bugs": {
        "url": "https://github.com/Vessel9817/workspace-sync/issues"
    },
    "scripts": {
        "test": "tsx --test \"test/**/*.test.ts\"",
        "start": "tsx ./src/cli.ts",
        "build": "tsc && tsc-alias",
        "tsc": "tsc --noEmit && tsc -p test"
    },
    "files": [
        "tsconfig.json",
        "*.md",
        "src/",
        "dist/",
        ".gitignore"
    ],
    "dependencies": {
        "commander": "^15.0.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "tsc-alias": "^1.9.7",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
